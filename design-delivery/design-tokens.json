{
  "$schema": "https://json.schemastore.org/design-token",
  "name": "Greenlight Design Tokens",
  "version": "1.0.0",
  "description": "Design tokens per Greenlight SaaS — Italian Editorial direction",
  "brand": {
    "essence": ["Fiducia", "Semplicità", "Italiano"],
    "direction": "Italian Editorial",
    "tagline": "Il semaforo del credito per le tue decisioni."
  },
  "colors": {
    "primary": {
      "50": { "value": "#f0fdf4", "rgb": [240,253,244], "hsl": [142,72,96] },
      "100": { "value": "#dcfce7", "rgb": [220,252,231], "hsl": [140,71,93] },
      "500": { "value": "#22c55e", "rgb": [34,197,94], "hsl": [142,71,45] },
      "700": { "value": "#15803d", "rgb": [21,128,61], "hsl": [142,72,29] },
      "900": { "value": "#14532d", "rgb": [20,83,45], "hsl": [142,61,20] }
    },
    "neutral": {
      "50": { "value": "#fafafa", "rgb": [250,250,250], "hsl": [0,0,98] },
      "100": { "value": "#f5f5f5", "rgb": [245,245,245], "hsl": [0,0,96] },
      "200": { "value": "#e5e5e5", "rgb": [229,229,229], "hsl": [0,0,90] },
      "300": { "value": "#d4d4d4", "rgb": [212,212,212], "hsl": [0,0,83] },
      "400": { "value": "#a3a3a3", "rgb": [163,163,163], "hsl": [0,0,64] },
      "600": { "value": "#525252", "rgb": [82,82,82], "hsl": [0,0,32] },
      "800": { "value": "#262626", "rgb": [38,38,38], "hsl": [0,0,15] },
      "950": { "value": "#0a0a0a", "rgb": [10,10,10], "hsl": [0,0,4] }
    },
    "semantic": {
      "verde": { "value": "#17b26a", "rgb": [23,178,106], "hsl": [151,76,39], "usage": "Affidabile / VAI", "contrast": ">=4.5:1 su bianco e nero" },
      "giallo": { "value": "#f5c518", "rgb": [245,197,24], "hsl": [46,89,53], "usage": "Attenzione", "contrast": ">=3:1 solo testo grande (>=18px), testo nero su giallo" },
      "arancio": { "value": "#f07818", "rgb": [240,120,24], "hsl": [26,82,52], "usage": "Rischio Medio", "contrast": ">=4.5:1" },
      "rosso": { "value": "#e5484d", "rgb": [229,72,77], "hsl": [358,52,59], "usage": "Alto Rischio / FERMA", "contrast": ">=4.5:1" },
      "pending": { "value": "#6366f1", "rgb": [99,102,241], "hsl": [239,80,67], "usage": "In elaborazione" },
      "error": { "value": "#78716c", "rgb": [120,113,108], "hsl": [30,6,45], "usage": "Errore" }
    },
    "accent": {
      "oro": { "value": "#b08968", "rgb": [176,137,104], "hsl": [26,30,55], "usage": "Elementi decorativi, prezzi, dettagli editoriali" }
    },
    "semanticBackgrounds": {
      "light": { "background": "#fafafa", "surface": "#ffffff", "text": "#0a0a0a" },
      "dark": { "background": "#0a0a0a", "surface": "#111111", "text": "#fafafa" }
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px",
      "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px"
    }
  },
  "radius": {
    "sm": "6px",
    "md": "8px",
    "lg": "12px",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "md": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)",
    "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)"
  },
  "typography": {
    "fontFamilies": {
      "serif": ["Source Serif 4", "Georgia", "serif"],
      "sans": ["Inter", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "ui-monospace", "monospace"]
    },
    "fontSizes": {
      "display": { "size": "clamp(2.3rem, 10.6vw, 9.5rem)", "lineHeight": "0.84", "letterSpacing": "-0.035em" },
      "head": { "size": "clamp(2rem, 1.35rem + 3vw, 3.75rem)", "lineHeight": "0.95", "letterSpacing": "-0.025em" },
      "lead": { "size": "clamp(1.1875rem, 1.05rem + 0.65vw, 1.625rem)", "lineHeight": "1.3", "letterSpacing": "0" },
      "body": { "size": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)", "lineHeight": "1.55", "letterSpacing": "0" },
      "small": { "size": "clamp(0.8125rem, 0.79rem + 0.1vw, 0.875rem)", "lineHeight": "1.45", "letterSpacing": "0" },
      "xs": { "size": "0.75rem", "lineHeight": "1.4", "letterSpacing": "0.02em" }
    },
    "fontWeights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "motion": {
    "micro": { "duration": "150ms", "easing": "cubic-bezier(0.22, 1, 0.36, 1)" },
    "transition": { "duration": "300ms", "easing": "cubic-bezier(0.22, 1, 0.36, 1)" },
    "entrance": { "duration": "600ms", "easing": "cubic-bezier(0.2, 0.7, 0.3, 1)" },
    "ignite": { "duration": "420ms", "delay": "320ms", "easing": "cubic-bezier(0.2, 0.7, 0.3, 1)" }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "zIndex": {
    "dropdown": 100,
    "modal": 200,
    "tooltip": 300,
    "toast": 400
  }
}
